new file mode 100644
index 0000000..71e7a3c
--- /dev/null
+++ b/crates/liteparse/examples/ocria_dump.rs
@@ -0,0 +1,34 @@
+//! ppu-ocria-nano goldens (scratch clone only): run the ocria-nano OCR stage on PNG pages and
+//! write each stage's recorded values plus the final results as JSON.
+//! Usage: OCRIA_DUMP=1 ocria_dump <model_dir> <ort_dylib> <out_dir> <png>...
+use liteparse::ocr::OcrImage;
+use liteparse::ocr::ocria::{OcriaEngine, OcriaOptions, golden};
+use std::path::Path;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let engine = OcriaEngine::load(Path::new(&a[1]), Some(Path::new(&a[2])), OcriaOptions::default())
+        .expect("load");
+    let out_dir = Path::new(&a[3]);
+    for png in &a[4..] {
+        let img = OcrImage::from_file(png).expect("decode");
+        let (w, h) = img.dimensions();
+        let px = img.pixels(false).expect("pixels");
+        golden::take();
+        let res = engine.run(&px, w, h).expect("run");
+        let rec: Vec<serde_json::Value> = golden::take()
+            .into_iter()
+            .map(|(k, v)| serde_json::json!({"k": k, "v": v}))
+            .collect();
+        let name = Path::new(png).file_stem().unwrap().to_string_lossy().to_string();
+        let doc = serde_json::json!({
+            "image": Path::new(png).file_name().unwrap().to_string_lossy(),
+            "width": w, "height": h,
+            "pixels_sha": golden::hash(&px),
+            "stages": rec,
+            "results": res,
+        });
+        std::fs::write(out_dir.join(format!("{name}.ocr.json")), serde_json::to_string(&doc).unwrap()).unwrap();
+        eprintln!("{name}: {} lines", res.len());
+    }
+}
diff --git a/crates/liteparse/examples/ocria_parse_dump.rs b/crates/liteparse/examples/ocria_parse_dump.rs
new file mode 100644
index 0000000..fdfffe9
--- /dev/null
+++ b/crates/liteparse/examples/ocria_parse_dump.rs
@@ -0,0 +1,65 @@
+//! ppu-ocria-nano goldens (scratch clone only): parse PNG pages through LiteParse's full pipeline
+//! (ocria-nano OCR on the page image itself, LayoutNet from tablenet.onnx, markdown) and write each
+//! stage's recorded values plus the result as JSON.
+//! Usage: OCRIA_DUMP=1 ocria_parse_dump <model_dir> <ort_dylib> <out_dir> <png>...
+use liteparse::config::{LiteParseConfig, OutputFormat};
+use liteparse::ocr::ocria::{OcriaEngine, OcriaOptions, golden};
+use liteparse::parser::LiteParse;
+use std::collections::HashMap;
+use std::path::Path;
+use std::sync::Arc;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let dir = Path::new(&a[1]);
+    let engine = Arc::new(
+        OcriaEngine::load(dir, Some(Path::new(&a[2])), OcriaOptions::default()).expect("load"),
+    );
+    let out_dir = Path::new(&a[3]);
+    let rt = tokio::runtime::Builder::new_multi_thread().enable_all().build().unwrap();
+    for png in &a[4..] {
+        let png_abs = std::fs::canonicalize(png).unwrap().to_string_lossy().to_string();
+        let mut config = LiteParseConfig::default();
+        config.output_format = OutputFormat::Markdown;
+        config.table_model = Some(dir.join("tablenet.onnx").to_string_lossy().to_string());
+        let is_pdf = png_abs.ends_with(".pdf");
+        if !is_pdf {
+            config.ocr_page_images = HashMap::from([(1u32, png_abs.clone())]);
+        }
+        config.quiet = true;
+        config.ocr_enabled = true;
+        config.extract_blocks = true;
+        config.num_workers = 1;
+        // SAFETY: single-threaded at this point; read by render_raw during the parse below
+        unsafe {
+            if is_pdf {
+                std::env::remove_var("OCRIA_RAW_IMAGE")
+            } else {
+                std::env::set_var("OCRIA_RAW_IMAGE", &png_abs)
+            }
+        };
+        let parser = LiteParse::new(config).with_ocr_engine(engine.clone());
+        golden::take();
+        let res = match rt.block_on(parser.parse(&png_abs)) {
+            Ok(r) => r,
+            Err(e) => {
+                eprintln!("{png}: skipped ({e})");
+                continue;
+            }
+        };
+        let rec: Vec<serde_json::Value> = golden::take()
+            .into_iter()
+            .filter(|(k, _)| !k.starts_with("det.") && !k.starts_with("rec.") && !k.starts_with("router.") && !k.starts_with("read.") && !k.starts_with("page.") && k != "route")
+            .map(|(k, v)| serde_json::json!({"k": k, "v": v}))
+            .collect();
+        let name = Path::new(png).file_stem().unwrap().to_string_lossy().to_string();
+        let doc = serde_json::json!({
+            "image": Path::new(png).file_name().unwrap().to_string_lossy(),
+            "stages": rec,
+            "text": res.text,
+            "pages": res.pages,
+        });
+        std::fs::write(out_dir.join(format!("{name}.parse.json")), serde_json::to_string(&doc).unwrap()).unwrap();
+        eprintln!("{name}: {} chars of markdown", res.text.len());
+    }
+}
