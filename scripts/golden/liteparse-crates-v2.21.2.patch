diff --git a/crates/liteparse/src/ocr/ocria/golden.rs b/crates/liteparse/src/ocr/ocria/golden.rs
new file mode 100644
index 0000000..b721891
--- /dev/null
+++ b/crates/liteparse/src/ocr/ocria/golden.rs
@@ -0,0 +1,25 @@
+//! Golden recorder for the ppu-ocria-nano port (scratch clone only): stage values pushed when
+//! OCRIA_DUMP is set. No pipeline logic changes.
+use std::sync::Mutex;
+pub static REC: Mutex<Vec<(String, serde_json::Value)>> = Mutex::new(Vec::new());
+pub fn on() -> bool {
+    std::env::var_os("OCRIA_DUMP").is_some()
+}
+pub fn put(k: &str, v: serde_json::Value) {
+    if on() {
+        REC.lock().unwrap().push((k.to_string(), v));
+    }
+}
+pub fn take() -> Vec<(String, serde_json::Value)> {
+    std::mem::take(&mut *REC.lock().unwrap())
+}
+pub fn hash(b: &[u8]) -> String {
+    use sha2::{Digest, Sha256};
+    format!("{:x}", Sha256::digest(b))
+}
+pub fn img(i: &super::img::Img) -> serde_json::Value {
+    serde_json::json!({"w": i.w, "h": i.h, "ch": i.ch, "sha": hash(&i.data)})
+}
+pub fn ser_sha<S: serde::Serializer>(v: &[u8], s: S) -> Result<S::Ok, S::Error> {
+    s.serialize_str(&hash(v))
+}
